# Run the boundary gate from the MAIN checkout, not $PWD.
#
# Agent worktrees deliberately carry no node_modules (a `pnpm install` there
# leaves better-sqlite3's native binding unbuilt and yields hundreds of phantom
# failures), so a bare `pnpm run` here dies with `tsx: not found` and blocks the
# push. Same defect the pre-commit hook had, fixed the same way:
# `--git-common-dir` resolves the main checkout from any linked worktree.
#
# `--root` is separate and mandatory: the script's default root is
# process.cwd(), which the `cd` above has just made the main checkout, so
# without it a push from a linked worktree scanned MAIN's index instead of the
# committing worktree's — and printed "passed". The registry still resolves
# through the main checkout via findMainCheckoutRoot's fallback.
#
# Known gap, pre-existing: `--index` scans the INDEX, not the refs being
# pushed. A leaky commit already in history passes as long as the index is
# clean. commit-msg and pre-commit gate content at commit time, which is where
# this install actually catches leaks; closing the gap here means diffing
# each pushed ref against its remote counterpart. Do not describe this hook
# as scanning "the content being pushed" until it does.
repo_root=$(dirname "$(cd "$(git rev-parse --git-common-dir)" && pwd)")
worktree_root=$(git rev-parse --show-toplevel)
(cd "$repo_root" && pnpm run check:public-boundary -- --root "$worktree_root" --index)
