[Unit]
Description=Monthly NanoClaw design-artifact-loop drift check (vendored systems + technique)
Documentation=file:///home/ubuntu/nanoclaw-v2/scripts/check-design-drift.sh
After=network-online.target nanoclaw-v2.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nanoclaw-v2
ExecStart=/bin/bash /home/ubuntu/nanoclaw-v2/scripts/check-design-drift.sh
StandardOutput=journal
StandardError=journal
# No automatic restart — failures surface in journalctl.
