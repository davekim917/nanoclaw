{
  "livePaths": {
    "slack-inbound": {
      "description": "Slack events over Socket Mode reaching the router as inbound messages",
      "tests": ["src/channels/slack-live-path.test.ts"]
    },
    "slack-outbound": {
      "description": "Agent replies posted to Slack through the adapter and the Web API",
      "tests": ["src/channels/slack-live-path.test.ts"]
    },
    "discord-inbound": {
      "description": "Discord gateway events reaching the router as inbound messages",
      "tests": []
    },
    "discord-outbound": {
      "description": "Agent replies posted to Discord through the adapter and the REST API",
      "tests": []
    },
    "attachment-download": {
      "description": "Files attached to Slack and Discord messages downloaded for the agent",
      "tests": []
    },
    "onecli-gateway": {
      "description": "Host calls to the OneCLI control API that every container spawn depends on",
      "tests": []
    },
    "provider-claude": {
      "description": "Agent turns through the Claude Agent SDK and the Claude Code CLI in the container",
      "tests": []
    },
    "provider-codex": {
      "description": "Agent turns through the Codex CLI in the container",
      "tests": []
    },
    "provider-opencode": {
      "description": "Agent turns through OpenCode in the container",
      "tests": []
    },
    "mcp-tools": {
      "description": "The agent-runner's MCP servers and clients",
      "tests": []
    }
  },
  "packages": {
    "@chat-adapter/discord": {
      "kind": "live",
