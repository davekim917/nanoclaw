# Background workgroup memory capture is opt-in. Run the memory runtime
# verifier before enabling, then restart the service and verify the live queue.
# This flag gates BOTH halves of the fact system: writing new facts into
# generated/memory.md, and recalling the ones already there. Off means the
# ledger is served from neither recall lane. See docs/memory.md.
NANOCLAW_MEMORY_CURATOR_ENABLED=false
