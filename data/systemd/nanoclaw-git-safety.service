[Unit]
Description=NanoClaw git safety net: snapshot host-only git work, commit and push groups/ config
# Snapshots every commit on no remote and every uncommitted edit, across all
# worktrees, into ~/nanoclaw-backups/<stamp>/ (14-day retention), then commits
# and pushes groups/'s pending config. Runs before storage-gc (09:00 UTC) so
# anything the GC collects has already been captured. DMs the owner on failure;
# health-sentinel's WATCHED_TIMERS alerts if the timer stops firing.
After=network.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/nanoclaw-v2
Environment=HOME=/home/ubuntu
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/ubuntu/.local/bin:/home/ubuntu/.npm-global/bin
Environment="GIT_SAFETY_EXTRA_REPOS=/home/ubuntu/nanoclaw /home/ubuntu/plugins/*"
ExecStart=/bin/bash /home/ubuntu/nanoclaw-v2/scripts/git-safety.sh
IOSchedulingClass=idle
Nice=10
TimeoutStartSec=1h
StandardOutput=journal
StandardError=journal
