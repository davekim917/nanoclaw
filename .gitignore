# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
# data/* (not data/) so the !data/systemd/ and !data/logrotate/ exceptions
# can re-include those tracked subdirectories. Per-install runtime state
# (SQLite DBs, health JSON, lockfiles, archive) lives directly under data/
# and stays excluded.
data/*
!data/systemd/
!data/systemd/**
!data/logrotate/
!data/logrotate/**
logs/

# Groups - per-installation state, not tracked
groups/*

# Composer-managed CLAUDE.md artifacts (regenerated every spawn) and
# per-group standing instructions (CLAUDE.local.md) must never be committed.
**/CLAUDE.local.md
**/.claude-shared.md
**/.claude-fragments/

# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*
.playwright-mcp/
__pycache__/
*.py[cod]

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs
.gitnexus

# Runtime lock files
.claude/scheduled_tasks.lock

# Skill scratch dir (drift sots/targets, /team-* working files, etc.) — pure transient state
.claude/tmp/

# Local env backups
.env.pre-*
.env.bak*

# Codex plugin marker
.codex
# Stays ignored — do NOT track. Attempted 2026-07-29 and `check:public-boundary`
# rejected it with 9 private-identifier findings: the OneCLI migration doc records
# this install's agent groups and vault entries, the smoke test hardcodes a private
# org repo, and the upgrade script selects containers by install-specific name.
# That content cannot meet the public boundary without being gutted.
#
# It now lives versioned in the PRIVATE operator repo at groups/_ops/onecli/
# (scripts/check-onecli-drift.sh points there, overridable via ONECLI_RUNBOOK, and
# skips cleanly when absent). This entry stays as a tripwire so install-specific
# operator content doesn't drift back into the public-boundary repo.
.migrations/
.env.pre-migration.*

# Per-install recall eval corpus (generated by scripts/regenerate-recall-eval.ts)
data/recall-eval-set.json
# Per-install recall eval results audit log (generated by scripts/run-recall-eval.ts)
data/recall-eval-results.json

# Provider agent surfaces (generated)
.agents
AGENTS.md

# Internal working docs, never committed
docs/maintainer-guide.md
docs/drafts/
forks.md

# impeccable plugin hook cache — regenerated wherever the hook runs
.impeccable/

# design-artifact-loop scratch. The comp renders this install's real agent and
# channel names, so it stays local and out of the public boundary; only the
# design system it conforms to is tracked.
.design-artifact-loop/*
!.design-artifact-loop/*/
.design-artifact-loop/*/*
!.design-artifact-loop/*/DESIGN.md

# runtime/build artifacts
/.lock
dashboard/tsconfig.tsbuildinfo
