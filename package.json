{
  "name": "nanoclaw",
  "version": "2.1.53",
  "description": "Personal Claude assistant. Lightweight, secure, customizable.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "main": "dist/index.js",
  "bin": {
    "ncl": "bin/ncl"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky",
    "setup": "tsx setup/index.ts",
    "setup:auto": "tsx setup/auto.ts",
    "ncl": "tsx src/cli/client.ts",
    "chat": "tsx scripts/chat.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:graphify-runtime": "pnpm run build && node dist/graphify-daemon/runtime-acceptance.js",
    "check:public-boundary": "tsx scripts/check-public-boundary.ts",
    "build:dashboard": "cd dashboard && pnpm install --ignore-workspace --frozen-lockfile && pnpm vite build"
  },
  "dependencies": {
    "@chat-adapter/discord": "4.29.0",
    "@chat-adapter/slack": "4.29.0",
    "@clack/core": "^1.4.3",
    "@clack/prompts": "^1.7.0",
    "@onecli-sh/sdk": "2.2.1",
    "@slack/web-api": "8.0.0",
    "better-sqlite3": "11.10.0",
    "chat": "4.29.0",
    "chokidar": "5.0.0",
    "cron-parser": "5.6.2",
    "discord.js": "^14.27.0",
    "kleur": "^4.1.5",
    "undici": "6.24.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "eslint": "^10.8.0",
    "eslint-plugin-no-catch-all": "^1.1.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "ws@<8.20.1": "^8.20.1"
    },
    "patchedDependencies": {
      "@chat-adapter/discord@4.29.0": "patches/@chat-adapter__discord@4.29.0.patch"
    }
  }
}
