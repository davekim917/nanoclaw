[Unit]
Description=Run NanoClaw design-loop drift check on the 1st of every month at 09:30 UTC

[Timer]
# OnCalendar uses systemd.time(7) syntax: "MM-DD HH:MM:SS". Offset 30 min from the
# OneCLI drift check (09:00) so the two monthly jobs don't overlap.
OnCalendar=*-*-01 09:30:00
# If the system was off when the timer should have fired, run on next boot.
Persistent=true
# Random spread up to 30 min so it doesn't slam GitHub's API at exactly 09:30.
RandomizedDelaySec=1800
Unit=design-drift-check.service

[Install]
WantedBy=timers.target
